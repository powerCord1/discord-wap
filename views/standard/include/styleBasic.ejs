<style>
    /* Basics */
    body {
        background-color: #eef;
        font-size: 10px;
        margin: 0;
        <% if (wordBreakMethod == 'css') { %>
            word-break: break-word;
        <% } %>
    }

    /* Section beginning (title) */
    .sb {
        background-color: #23a;
        color: white;
        font-weight: bold;
    }

    /* Section content */
    .s, form {
        background-color: white;
        color: black;
    }

    /* Table column for mentions/pings in inbox */
    .mention {
        width: 16px;
        text-align: right;
        font-weight: bold;
        color: #c23;
    }

    /* Navigation links */
    .nav {
        text-align: center;
        font-size: 11px;
        padding: 1px;
    }

    /* Message timestamp */
    .time {
        font-size: 8px;
        text-align: right;
    }

    /* Recipient message */
    .reply {
        color: #444;
        font-size: 9px;
        font-style: italic;
    }

    /* Last message timestamp in channel list */
    .chtime {
        color: #444;
        font-size: 9px;
        text-align: right;
    }

    /* Embeds */
    .embed {
        border-left: 2px solid #4f545c;
        padding-left: 3px;
        margin: 2px 0;
    }
    .embedtitle {
        font-weight: bold;
    }
    .embedauthor {
        font-size: 9px;
        font-weight: bold;
        color: #555;
    }
    .embedfooter {
        font-size: 8px;
        color: #666;
    }

    /* Emojis */
    img.emoji {
        width: 1.1em;
        height: 1.1em;
        vertical-align: -0.15em;
    }

    /* Reactions */
    .reactions {
        margin-top: 2px;
        margin-bottom: 2px;
    }
    .reaction {
        display: inline-block;
        padding: 0 3px;
        margin-right: 3px;
        text-decoration: none;
        font-size: 10px;
    }
    .reaction-me {
        border-color: #5865f2;
        background-color: #eee;
    }
    .reaction-count {
        color: #ffffff;
        background-color: #555;
        padding: 0 2px;
        margin-left: 2px;
    }
    .reaction-count-me {
        color: #0055ff;
        margin-left: 2px;
        font-weight: bold;
    }
</style>