<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title><%= cname %></title>
</head>
<body>
    <div class="nav">
        <a href="<%= gpath %>/<%= id %><%= tokenParam %><%= settings.reverseChat ? '#b' : '' %>">&lt; <%= cname %></a>
    </div>

    <div class="sb">Reply to <%- fit(recname) %></div>
    <form action="<%= gpath %>/<%= id %>/send" method="post" enctype="multipart/form-data">
        <input type="hidden" name="t" value="<%= compressedToken %>">
        <% if (locals.gid) { %><input type="hidden" name="gid" value="<%= gid %>"><% } %>
        <input type="hidden" name="id" value="<%= id %>">
        <input type="hidden" name="recipient" value="<%= rec %>"/>
        <div><textarea name="text" id="text" rows="5" maxlength="2000"></textarea></div>
        <div>
            <label for="file">Attach file (max 20MB):</label>
            <input type="file" name="file" id="file">
        </div>
        <div>
            <input type="checkbox" name="ping" id="ping" value="1">
            <label for="ping">Mention author</label>
        </div>
        <div><input type="submit" value="Send"></div>
    </form>
</body>
</html>
