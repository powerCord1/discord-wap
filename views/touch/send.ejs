<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title><%= cname %></title>
</head>
<body>
    <table class="nav" id="t">
        <tr>
            <td><a href="<%= gpath %>/<%= id %><%= tokenParam %><%= settings.reverseChat ? '#b' : '' %>"><img src="/back.png" alt="Back"></a></td>
            <td class="title"><%- fit(cname) %></td>
            <td><a href="#b"><img src="/btm.png" alt="Bottom"></a></td>
        </tr>
    </table>

    <div class="section">
        <form action="<%= gpath %>/<%= id %>/send" method="post" enctype="multipart/form-data">
            <input type="hidden" name="t" value="<%= compressedToken %>">
            <input type="hidden" name="id" value="<%= id %>">
            <% if (locals.gid) { %><input type="hidden" name="gid" value="<%= gid %>"><% } %>
            <% if (locals.recipient) { %><input type="hidden" name="recipient" value="<%= recipient %>"><% } %>
            <% if (locals.ping !== undefined && locals.ping !== '') { %><input type="hidden" name="ping" value="<%= ping %>"><% } %>
            <label for="text">Your message:</label>
            <div><textarea name="text" id="text" rows="5" maxlength="2000"><%= locals.text || '' %></textarea></div>
            <label for="file">Attach file (max 20MB):</label>
            <div>
                <input type="file" name="file" id="file">
                <input type="submit" name="mention" value="Insert mention">
            </div>
            <input type="submit" value="Send" style="margin-top: 6px;">
        </form>
    </div>
</body>
</html>
