<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card id="msg" title="<%- sanitize(cname) %>">
        <p align="center">
            <anchor>
                <go method="get" href="<%= gpath %>/<%= id %>">
                    <postfield name="token" value="$(token)"/>
                </go>
                Back
            </anchor>
        </p>

        <p>
            <b><%- sanitize(authorName) %>:</b> <%- fit(content) %>
        </p>

        <p>
            <anchor>
                <go href="#reply">
                    <setvar name="message" value=""/>
                    <setvar name="rec" value="<%= msgid %>"/>
                    <setvar name="recname" value="<%- sanitize(authorName) %>"/>
                </go>
                Reply to message
            </anchor>
            <% if (isOwn) { %>
                <br/>
                <anchor>
                    <go method="get" href="<%= gpath %>/<%= id %>/m/<%= msgid %>/edit">
                        <postfield name="token" value="$(token)"/>
                    </go>
                    Edit message
                </anchor>
                <br/>
                <anchor>
                    <go method="post" href="<%= gpath %>/<%= id %>/m/<%= msgid %>/delete">
                        <postfield name="token" value="$(token)"/>
                    </go>
                    Delete message
                </anchor>
            <% } %>
            <br/>
            <anchor>
                <go method="get" href="<%= gpath %>/<%= id %>/m/<%= msgid %>/share">
                    <postfield name="token" value="$(token)"/>
                </go>
                Share
            </anchor>
            <% if (links && links.length > 0) { %>
                <% links.forEach(link => { %>
                    <br/>
                    <a href="<%= link %>">Open link: <%= link %></a>
                <% }) %>
            <% } %>
        </p>
    </card>

    <card id="reply" title="<%- sanitize(cname) %>">
        <onevent type="onenterbackward">
            <prev/>
        </onevent>

        <p>
            Reply to $(recname)
            <br/>
            <input name="message" size="<%= settings.limitTextBoxSize ? 200 : 2000 %>"/>
        </p>

        <p align="center">
            <anchor>
                <go method="post" href="<%= gpath %>/<%= id %>/send">
                    <postfield name="token" value="$(token)"/>
                    <postfield name="text" value="$(message)"/>
                    <postfield name="recipient" value="$(rec)"/>
                </go>
                Send @ON
            </anchor>
            <br/>
            <anchor>
                <go method="post" href="<%= gpath %>/<%= id %>/send">
                    <postfield name="token" value="$(token)"/>
                    <postfield name="text" value="$(message)"/>
                    <postfield name="recipient" value="$(rec)"/>
                    <postfield name="ping" value="0"/>
                </go>
                Send @OFF
            </anchor>
            <br/>
            <anchor>
                <prev/>
                Back
            </anchor>
        </p>
    </card>
</wml>
